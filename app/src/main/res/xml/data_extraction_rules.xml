<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Keep settings, skip the avatar file (external files) in both cloud backup and
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
