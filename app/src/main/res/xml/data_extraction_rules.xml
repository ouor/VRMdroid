<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Only settings move, in both cloud backup and device-to-device transfer; with an
     <include>, everything else (the avatar file in external files) is left out. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
