<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. The avatar VRM can be tens of MB, which would exceed the 25MB
     backup quota and make the whole backup get skipped. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
